<!DOCTYPE html>
<html lang="zh-CN" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>影子丛林 - 树懒</title>
    <style id="theme-vars">
:root {
  --brand-color-primary: #6C5CE7;
  --brand-color-primary-light: #A29BFE;
  --brand-state-success: #00B894;
  --brand-state-warning: #FDCB6E;
  --brand-state-error: #FF7675;
  --brand-jungle-base: #1A1A2E;
  --brand-jungle-ground: #16213E;
  --brand-jungle-cyan: #00D2FF;
  --brand-jungle-green: #A8FF78;
  --brand-jungle-gold: #F2C94C;
  --brand-jungle-purple: #CE93D8;
  --brand-sloth-brown: #8D6E63;
  --brand-sloth-fur: #A1887F;
  --brand-vine-brown: #5C4033;
  --brand-sand-gold: #F5DEB3;
  --brand-font-display: 'Nunito', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --brand-font-body: 'Nunito', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
    
    /* === 语音引导设置面板 === */
    .voice-settings-btn {
      position: fixed;
      top: calc(env(safe-area-inset-top, 0px) + 56px);
      right: 12px;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.2);
      color: #fff;
      cursor: pointer;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      -webkit-tap-highlight-color: transparent;
      transition: transform 0.15s;
    }
    .voice-settings-btn:active { transform: scale(0.9); }
    .voice-settings-btn.muted { opacity: 0.5; }
    
    .voice-settings-panel {
      position: fixed;
      top: calc(env(safe-area-inset-top, 0px) + 100px);
      right: 12px;
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 16px;
      padding: 16px;
      z-index: 101;
      min-width: 200px;
      border: 1px solid rgba(255,255,255,0.15);
      display: none;
      animation: panelIn 0.2s ease-out;
    }
    .voice-settings-panel.show { display: block; }
    @keyframes panelIn {
      from { opacity: 0; transform: translateY(-8px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .voice-settings-title {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 12px;
    }
    .voice-setting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
    }
    .voice-setting-label {
      font-size: 13px;
      color: rgba(255,255,255,0.85);
    }
    .voice-toggle {
      width: 44px;
      height: 24px;
      border-radius: 12px;
      background: rgba(255,255,255,0.2);
      position: relative;
      cursor: pointer;
      transition: background 0.2s;
      border: none;
      padding: 0;
    }
    .voice-toggle.on { background: #4ECDC4; }
    .voice-toggle::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #fff;
      transition: left 0.2s;
    }
    .voice-toggle.on::after { left: 22px; }

  
    /* === 引导手势动画系统 === */
    .gesture-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .gesture-hand {
      position: absolute;
      font-size: 80px;
      opacity: 0;
      filter: drop-shadow(0 6px 16px rgba(0,0,0,0.6)) drop-shadow(0 0 12px rgba(255,255,255,0.5));
      pointer-events: none;
      z-index: 9999;
    }
    /* 点击手势 - 在目标位置脉冲 */
    @keyframes gestureTap {
      0% { opacity: 0; transform: translate(-50%,-50%) scale(1.8); }
      15% { opacity: 1; transform: translate(-50%,-50%) scale(1.1); }
      40% { opacity: 1; transform: translate(-50%,-50%) scale(0.95); }
      60% { opacity: 1; transform: translate(-50%,-50%) scale(1.1); }
      80% { opacity: 0.9; transform: translate(-50%,-50%) scale(1); }
      100% { opacity: 0; transform: translate(-50%,-50%) scale(1.3); }
    }
    .gesture-tap-anim {
      animation: gestureTap 1.8s ease-in-out infinite;
    }
    /* 拖拽手势 - 从A拖到B */
    @keyframes gestureDragX {
      0% { opacity: 0; transform: translate(-50%,-50%) scale(1); left: var(--drag-from); }
      10% { opacity: 1; transform: translate(-50%,-50%) scale(1); left: var(--drag-from); }
      50% { opacity: 1; transform: translate(-50%,-50%) scale(1); left: var(--drag-to); }
      70% { opacity: 1; transform: translate(-50%,-50%) scale(0.9); left: var(--drag-to); }
      80% { opacity: 0.8; transform: translate(-50%,-50%) scale(1); left: var(--drag-to); }
      90% { opacity: 0; transform: translate(-50%,-50%) scale(1); left: var(--drag-to); }
      100% { opacity: 0; transform: translate(-50%,-50%) scale(1); left: var(--drag-from); }
    }
    /* 摩擦手势 - 两只手指来回搓 */
    @keyframes gestureRubLeft {
      0%, 100% { transform: translateX(-22px); }
      50% { transform: translateX(22px); }
    }
    @keyframes gestureRubRight {
      0%, 100% { transform: translateX(22px); }
      50% { transform: translateX(-22px); }
    }
    .gesture-rub-left {
      animation: gestureRubLeft 0.6s ease-in-out infinite;
    }
    .gesture-rub-right {
      animation: gestureRubRight 0.6s ease-in-out infinite;
    }
    /* 按住手势 - 手指按下不动 */
    @keyframes gesturePress {
      0% { opacity: 0; transform: translate(-50%,-50%) scale(1.5); }
      20% { opacity: 1; transform: translate(-50%,-50%) scale(1.1); }
      50% { opacity: 1; transform: translate(-50%,-50%) scale(0.9); }
      80% { opacity: 0.9; transform: translate(-50%,-50%) scale(0.95); }
      100% { opacity: 0; transform: translate(-50%,-50%) scale(1); }
    }
    .gesture-press-anim {
      animation: gesturePress 2s ease-in-out infinite;
    }
    /* 点击涟漪效果 */
    @keyframes gestureRipple {
      0% { transform: translate(-50%,-50%) scale(0.5); opacity: 0.8; }
      100% { transform: translate(-50%,-50%) scale(3); opacity: 0; }
    }
    .gesture-ripple {
      position: absolute;
      width: 60px; height: 60px;
      border-radius: 50%;
      border: 4px solid rgba(255,200,60,0.9);
      pointer-events: none;
      z-index: 9999;
    }
    .gesture-ripple-anim {
      animation: gestureRipple 1.8s ease-out infinite;
    }
    /* 滑动方向箭头 */
    @keyframes gestureSlideUp {
      0% { opacity: 0; transform: translateY(20px); }
      20% { opacity: 1; }
      80% { opacity: 1; transform: translateY(-40px); }
      100% { opacity: 0; transform: translateY(-60px); }
    }
    @keyframes gestureSlideLeft {
      0% { opacity: 0; transform: translateX(20px); }
      20% { opacity: 1; }
      80% { opacity: 1; transform: translateX(-40px); }
      100% { opacity: 0; transform: translateX(-60px); }
    }
      80% { opacity: 0.8; transform: translateX(-40px); }
      100% { opacity: 0; transform: translateX(-60px); }
    }

  
    /* === 小星星向导 === */
    .star-guide-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9998;
      pointer-events: none;
      transition: transform 0.3s;
    }
    .star-guide-container.hidden {
      opacity: 0;
      transform: scale(0.5);
      pointer-events: none;
    }
    .star-guide {
      width: 60px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 44px;
      cursor: pointer;
      filter: drop-shadow(0 4px 12px rgba(242,201,76,0.5));
      animation: starPulse 2s ease-in-out infinite;
      pointer-events: auto;
      transition: transform 0.2s;
    }
    .star-guide:hover {
      transform: scale(1.15);
    }
    .star-guide:active {
      transform: scale(0.95);
    }
    @keyframes starPulse {
      0%, 100% { transform: scale(1); filter: drop-shadow(0 4px 12px rgba(242,201,76,0.5)); }
      50% { transform: scale(1.08); filter: drop-shadow(0 6px 20px rgba(242,201,76,0.7)); }
    }
    .star-guide-balloon {
      position: absolute;
      bottom: 50px;
      right: 0;
      background: rgba(255,255,255,0.95);
      color: #333;
      padding: 10px 14px;
      border-radius: 16px;
      font-size: 13px;
      font-weight: 500;
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
      white-space: nowrap;
      max-width: 200px;
      opacity: 0;
      transform: translateY(10px) scale(0.9);
      transition: all 0.3s ease-out;
      pointer-events: none;
    }
    .star-guide-balloon.show {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    .star-guide-balloon::after {
      content: '';
      position: absolute;
      bottom: -8px;
      right: 14px;
      width: 16px;
      height: 16px;
      background: rgba(255,255,255,0.95);
      transform: rotate(45deg);
    }
    /* 飞行路径动画 */
    .star-guide-flying {
      position: fixed;
      z-index: 9999;
      pointer-events: none;
      font-size: 44px;
      filter: drop-shadow(0 6px 20px rgba(242,201,76,0.7));
    }
    @keyframes starFly {
      0% { opacity: 1; transform: scale(1); }
      100% { opacity: 1; transform: scale(1); }
    }
    /* 目标高亮光环 */
    .star-guide-target-glow {
      position: absolute;
      border-radius: 50%;
      border: 3px solid #F2C94C;
      animation: targetGlow 1.5s ease-in-out infinite;
      pointer-events: none;
      z-index: 9997;
    }
    @keyframes targetGlow {
      0%, 100% { transform: scale(1); opacity: 0.6; }
      50% { transform: scale(1.15); opacity: 1; }
    }

  </style>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4.3.1/dist/index.global.js"></script>
    <script src="https://unpkg.com/lucide@1.8.0/dist/umd/lucide.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
      [data-icon] { display: inline-flex; align-items: center; justify-content: center; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center; background-color: currentColor; }
      .no-select { -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
    </style>
</head>
<body class="m-0 p-0 overflow-hidden min-h-screen no-select" style="background: #1A1A2E; font-family: var(--brand-font-body); overscroll-behavior: none; -webkit-tap-highlight-color: transparent;">

  <!-- ========== BACK BUTTON ========== -->
  <button data-dom-id="btn-back-to-map"
          class="fixed z-[60] inline-flex items-center justify-center"
          style="top: calc(env(safe-area-inset-top, 0px) + 56px); left: 12px; width: 40px; height: 40px; min-width: 40px; min-height: 40px; border-radius: 50%; background: rgba(26,26,46,0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(0,210,255,0.2); color: #E0E0E0;"
          aria-label="返回影子丛林">
    <i data-lucide="arrow-left" class="w-5 h-5"></i>
  </button>

  <!-- ========== TOP STATUS BAR ========== -->
  <header class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-4"
          style="min-height: 48px; padding-top: env(safe-area-inset-top, 0px); background: rgba(26,26,46,0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,210,255,0.12);">
    <div class="flex items-center gap-2">
      <div id="player-av" class="w-7 h-7 rounded-full flex items-center justify-center text-sm shrink-0"
           style="background: rgba(161,136,127,0.2); border: 1.5px solid rgba(161,136,127,0.4);">🧒</div>
      <span id="player-nm" class="text-white font-bold whitespace-nowrap" style="font-size: 12px; font-family: var(--font-body); text-shadow: 0 1px 3px rgba(0,0,0,0.3); max-width: 60px; overflow: hidden; text-overflow: ellipsis;">小探险家</span>
      <span class="text-white/40 text-xs">|</span>
      <span id="friend-count" class="text-xs font-semibold whitespace-nowrap" style="color: #FFFFFF;">朋友 4/10</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-sm font-bold whitespace-nowrap" style="color: #FFFFFF; text-shadow: 0 0 10px rgba(161,136,127,0.4);">🦥 树懒</span>
    </div>
    <div class="flex items-center gap-1">
      <span class="text-base star-gem-filled">★</span>
      <span class="text-base star-gem-empty">☆</span>
      <span class="text-base star-gem-empty">☆</span>
    </div>
  </header>

  <!-- ========== HINT BANNER ========== -->
  <div id="hint-banner" class="fixed z-40 left-1/2 -translate-x-1/2 px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap transition-all duration-500"
       style="top: calc(env(safe-area-inset-top, 0px) + 56px); background: rgba(26,26,46,0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(161,136,127,0.5); color: #D7CCC8; text-shadow: 0 0 8px rgba(161,136,127,0.4); box-shadow: 0 0 20px rgba(161,136,127,0.2);">
    <span id="hint-text">藤蔓桥上有个大掌印~点一下看看？</span>
  </div>

  <!-- ========== MAIN SCENE ========== -->
  <main class="relative w-full h-screen overflow-hidden">
    <!-- Background scene -->
    <div class="absolute inset-0">
      <img src="data:image/jpeg;base64," alt="影子丛林藤蔓桥出口" class="w-full h-full object-cover" />
      <div id="scene-overlay" class="absolute inset-0" style="background:
        /* Darken upper area, focus on bridge path in center */
        radial-gradient(ellipse 350px 120px at 50% 55%, rgba(120,90,50,0.15) 0%, transparent 70%),
        radial-gradient(ellipse 200px 300px at 20% 30%, rgba(10,20,35,0.6) 0%, transparent 60%),
        radial-gradient(ellipse 200px 300px at 80% 30%, rgba(10,20,35,0.6) 0%, transparent 60%),
        linear-gradient(180deg, rgba(26,26,46,0.5) 0%, rgba(22,33,62,0.2) 40%, rgba(26,26,46,0.4) 100%);
      transition: background 1s;"></div>
    </div>

    <!-- Moon -->
    <div class="absolute pointer-events-none" style="top: calc(env(safe-area-inset-top, 0px) + 90px); left: 50%; z-index: 4;">
      <div style="font-size: 44px; filter: drop-shadow(0 0 18px rgba(224,224,224,0.5)) drop-shadow(0 0 36px rgba(224,224,224,0.3));">🌙</div>
    </div>

    <!-- Ambient fireflies -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="ff-dot" style="top: 20%; left: 25%; --c:#A8FF78; --d:0s;"></div>
      <div class="ff-dot" style="top: 30%; left: 65%; --c:#F2C94C; --d:1.5s;"></div>
      <div class="ff-dot" style="top: 50%; left: 20%; --c:#00D2FF; --d:2.2s;"></div>
      <div class="ff-dot" style="top: 40%; left: 75%; --c:#A8FF78; --d:0.9s;"></div>
      <div class="ff-dot" style="top: 22%; left: 45%; --c:#CE93D8; --d:3.0s;"></div>
    </div>

    <!-- ===== VINE BRIDGE (spans center-bottom, the only path across) ===== -->
    <div class="absolute pointer-events-none" style="left: 0; right: 0; bottom: 20%; z-index: 5;">
      <!-- Bridge planks -->
      <div class="relative mx-auto" style="width: 80%; height: 130px;">
        <!-- Left support (attached to tree) -->
        <div style="position: absolute; left: -5%; top: 20px; width: 80px; height: 90px; background: linear-gradient(135deg, #4a3222, #2d1e10); border-radius: 12px; box-shadow: inset -4px -4px 10px rgba(0,0,0,0.5), 4px 4px 12px rgba(0,0,0,0.5);"></div>
        <!-- Right support -->
        <div style="position: absolute; right: -5%; top: 20px; width: 80px; height: 90px; background: linear-gradient(225deg, #4a3222, #2d1e10); border-radius: 12px; box-shadow: inset 4px -4px 10px rgba(0,0,0,0.5), -4px 4px 12px rgba(0,0,0,0.5);"></div>
        <!-- Bridge deck (horizontal planks) -->
        <div id="bridge-deck" style="position: absolute; left: 5%; right: 5%; top: 35px; height: 50px; display: flex; gap: 4px; transition: transform 0.3s;">
          <!-- Individual planks -->
        </div>
        <!-- Side ropes -->
        <div style="position: absolute; left: 3%; top: 20px; right: 3%; height: 8px; background: linear-gradient(180deg, #6b4423, #3d2817); border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.5);"></div>
        <div style="position: absolute; left: 3%; top: 78px; right: 3%; height: 8px; background: linear-gradient(180deg, #3d2817, #6b4423); border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.5);"></div>
        <!-- Hanging vines from bridge -->
        <div style="position: absolute; left: 25%; top: 80px; font-size: 24px; transform: rotate(-10deg);">🌿</div>
        <div style="position: absolute; left: 60%; top: 82px; font-size: 20px; transform: rotate(8deg);">🍃</div>
        <div style="position: absolute; left: 80%; top: 85px; font-size: 22px; transform: rotate(-5deg);">🌿</div>
      </div>
    </div>

    <!-- ===== PAW PRINT HOTSPOT (entrance to bridge) ===== -->
    <button id="paw-print" class="absolute z-10" aria-label="巨大的掌印"
            style="left: 15%; bottom: 28%; width: 110px; height: 110px; background: transparent; border: none; cursor: pointer; -webkit-tap-highlight-color: transparent;">
      <div id="paw-glow" style="position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle, rgba(161,136,127,0.4) 0%, transparent 70%); animation: pawPulse 1.5s ease-in-out infinite;"></div>
      <div style="position: relative; font-size: 72px; filter: drop-shadow(0 0 12px rgba(161,136,127,0.6)); line-height: 1;">🐾</div>
      <div style="position: absolute; bottom: -28px; left: 50%; transform: translateX(-50%); font-size: 11px; color: #D7CCC8; white-space: nowrap; text-shadow: 0 0 8px rgba(0,0,0,0.8); background: rgba(26,26,46,0.7); padding: 3px 10px; border-radius: 10px; border: 1px solid rgba(161,136,127,0.3);">点我~</div>
    </button>

    <!-- ===== SLOTH (sleeping on bridge, blocks path) ===== -->
    <div id="sloth-container" class="absolute z-[8]" style="left: 50%; bottom: 24%; transform: translateX(-50%); pointer-events: none;">
      <div id="sloth-body" style="position: relative; font-size: 110px; line-height: 1; transition: all 0.8s; filter: drop-shadow(3px 6px 12px rgba(0,0,0,0.5));">
        <span id="sloth-face" style="display: inline-block; transition: transform 0.3s;">😴</span>
      </div>
      <!-- Zzz sleeping -->
      <div id="sloth-zzz" style="position: absolute; top: -20px; right: -10px; font-size: 28px; color: rgba(224,224,224,0.7); animation: zzzFloat 2s ease-in-out infinite;">
        <span style="display: inline-block; animation: zzzFloat 2s ease-in-out infinite;">z</span>
        <span style="display: inline-block; font-size: 22px; animation: zzzFloat 2s ease-in-out infinite 0.3s; position: relative; top: -5px;">z</span>
        <span style="display: inline-block; font-size: 16px; animation: zzzFloat 2s ease-in-out infinite 0.6s; position: relative; top: -10px;">z</span>
      </div>
      <!-- Long-press target: sloth face area -->
      <button id="sloth-belly" class="absolute" aria-label="长按树懒"
              style="left: 50%; top: 40%; transform: translate(-50%, -50%); width: 90px; height: 80px; background: transparent; border: none; cursor: pointer; pointer-events: none; -webkit-tap-highlight-color: transparent; border-radius: 50%;">
      </button>
      <!-- Speech bubble for reactions -->
      <div id="sloth-bubble" style="position: absolute; top: -60px; left: 50%; transform: translateX(-50%) scale(0); background: rgba(26,26,46,0.9); border: 2px solid rgba(161,136,127,0.5); border-radius: 16px; padding: 6px 14px; font-size: 20px; font-weight: 700; color: #fff; white-space: nowrap; transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1); pointer-events: none; box-shadow: 0 4px 16px rgba(0,0,0,0.4);">
        <span id="bubble-text"></span>
        <div style="position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 8px solid transparent; border-right: 8px solid transparent; border-top: 10px solid rgba(161,136,127,0.5);"></div>
      </div>
    </div>

    <!-- ===== RING HOURGLASS TIMER ===== -->
    <div id="hourglass-wrap" class="fixed z-30 pointer-events-none" style="top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0); transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1);">
      <div style="position: relative; width: 180px; height: 180px;">
        <!-- Outer ring track -->
        <svg width="180" height="180" viewBox="0 0 180 180" style="position: absolute; inset: 0; transform: rotate(-90deg);">
          <circle cx="90" cy="90" r="80" fill="none" stroke="rgba(161,136,127,0.2)" stroke-width="10" stroke-linecap="round"/>
          <circle id="timer-ring" cx="90" cy="90" r="80" fill="none" stroke="url(#sandGradient)" stroke-width="10" stroke-linecap="round"
                  stroke-dasharray="502.65" stroke-dashoffset="502.65" style="transition: stroke-dashoffset 0.1s linear;"/>
          <defs>
            <linearGradient id="sandGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#F2C94C"/>
              <stop offset="100%" stop-color="#E67E22"/>
            </linearGradient>
          </defs>
        </svg>
        <!-- Hourglass icon in center -->
        <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column;">
          <div id="hourglass-icon" style="font-size: 56px; filter: drop-shadow(0 0 12px rgba(242,201,76,0.5)); animation: hourglassShake 0.5s ease-in-out infinite alternate;">⏳</div>
          <div id="timer-text" style="position: absolute; bottom: 20px; font-size: 14px; font-weight: 700; color: #F2C94C; text-shadow: 0 0 8px rgba(242,201,76,0.5);">5.0</div>
        </div>
      </div>
      <!-- Instruction text -->
      <div style="text-align: center; margin-top: 12px; font-size: 14px; font-weight: 700; color: #D7CCC8; text-shadow: 0 0 10px rgba(0,0,0,0.8);">
        按住树懒不动，耐心等5秒~
      </div>
    </div>

    <!-- ===== FRUIT CARDS (appear after long-press succeeds) ===== -->
    <div id="fruit-cards-wrap" class="fixed z-30 pointer-events-none" style="top: 50%; left: 50%; transform: translate(-50%, -50%); width: 320px; opacity: 0; transition: opacity 0.6s;">
      <div style="text-align: center; margin-bottom: 16px;">
        <div style="font-size: 16px; font-weight: 700; color: #D7CCC8; text-shadow: 0 2px 8px rgba(0,0,0,0.8); background: rgba(26,26,46,0.85); display: inline-block; padding: 8px 18px; border-radius: 20px; border: 1.5px solid rgba(161,136,127,0.4);">
          <span id="fruit-instruction">点一下卡片，说出水果的名字！</span>
        </div>
      </div>
      <div id="fruit-cards" style="display: flex; gap: 14px; justify-content: center; pointer-events: auto;">
        <!-- Cards generated by JS in order -->
      </div>
    </div>

    <!-- ===== MIC PROMPT (for fruit speech) ===== -->
    <div id="speech-prompt" class="fixed z-40 flex flex-col items-center pointer-events-none"
         style="top: 30%; left: 50%; transform: translateX(-50%) scale(0.7); opacity: 0; transition: all 0.5s;">
      <button id="mic-btn" class="pointer-events-auto flex items-center justify-center"
              style="width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, #00B894, #00D2FF); border: 3px solid rgba(255,255,255,0.3); box-shadow: 0 4px 20px rgba(0,210,255,0.4); cursor: pointer; -webkit-tap-highlight-color: transparent;">
        <span style="font-size: 32px;">🎤</span>
      </button>
      <div id="volume-bar-wrap" class="mt-2 w-24 h-2 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.2);">
        <div id="volume-bar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #00B894, #A8FF78); transition: width 0.1s;"></div>
      </div>
      <p class="text-[11px] mt-1" style="color: rgba(224,224,224,0.7); text-shadow: 0 1px 4px rgba(0,0,0,0.8);">点麦克风，再说出名字~</p>
    </div>

    <!-- ===== PATH OPENING (after sloth moves) ===== -->
    <div id="path-open" class="absolute pointer-events-none" style="left: 50%; bottom: 22%; transform: translateX(-50%); opacity: 0; transition: opacity 1s; z-index: 6;">
      <!-- Glowing path forward -->
      <div style="width: 120px; height: 120px; border-radius: 50%; background: radial-gradient(circle, rgba(168,255,120,0.5) 0%, rgba(168,255,120,0.1) 50%, transparent 70%); animation: pathGlow 2s ease-in-out infinite;">
        <div style="font-size: 64px; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); filter: drop-shadow(0 0 20px rgba(168,255,120,0.8));">✨</div>
      </div>
      <div style="text-align: center; margin-top: 8px; font-size: 16px; font-weight: 800; color: #A8FF78; text-shadow: 0 0 16px rgba(168,255,120,0.8);">
        路通啦！
      </div>
    </div>

    <!-- ===== SUCCESS OVERLAY ===== -->
    <div id="success-overlay" class="fixed inset-0 z-40 flex flex-col items-center justify-center pointer-events-none" style="background: radial-gradient(circle at center, rgba(161,136,127,0.15) 0%, rgba(26,26,46,0.75) 70%); opacity: 0; transition: opacity 0.8s;">
      <div style="text-align: center;">
        <div style="font-size: 56px; margin-bottom: 8px; animation: success-bounce 0.8s cubic-bezier(0.34,1.56,0.64,1);">🦥</div>
        <h2 style="font-family: var(--brand-font-display); font-size: 24px; font-weight: 800; color: #D7CCC8; text-shadow: 0 0 20px rgba(161,136,127,0.6); margin: 0 0 8px;">树懒让开啦！</h2>
        <p style="font-size: 14px; color: rgba(224,224,224,0.8); margin: 0 0 28px; text-shadow: 0 1px 4px rgba(0,0,0,0.5);">Slow = 慢的、慢慢的</p>
        <button id="btn-continue-adventure" class="pointer-events-auto" style="font-family: var(--brand-font-display); font-size: 18px; font-weight: 700; color: #1A1A2E; background: linear-gradient(135deg, #A8FF78 0%, #00D2FF 50%, #CE93D8 100%); border: none; border-radius: 999px; padding: 14px 36px; box-shadow: 0 0 24px rgba(168,255,120,0.5), 0 4px 20px rgba(0,210,255,0.4); cursor: pointer; -webkit-tap-highlight-color: transparent; animation: continuePulse 1.5s ease-in-out infinite; letter-spacing: 0.05em;">
          继续探险 →
        </button>
      </div>
    </div>

    <!-- Confetti -->
    <div id="confetti-container" class="fixed inset-0 pointer-events-none z-[45]"></div>
  </main>

  <!-- ========== SHADOW PROGRESS BAR ========== -->
  <div class="fixed z-40 w-full px-4 pointer-events-none"
       style="bottom: env(safe-area-inset-bottom, 0px); left: 0;">
    <div class="mx-auto w-full max-w-sm rounded-2xl px-4 py-3"
         style="background: rgba(22,33,62,0.7); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(0,210,255,0.2);">
      <div class="flex items-center justify-between mb-2">
        <span id="shadow-count" class="text-xs font-semibold whitespace-nowrap" style="color: #00D2FF;">影子收集 1/4</span>
        <span class="text-xs whitespace-nowrap" style="color: rgba(224,224,224,0.5);">集齐4个影子会变成星光箭头！</span>
      </div>
      <div class="flex items-center justify-between gap-2">
        <div class="shadow-slot flex items-center justify-center" style="width:52px;height:52px;border-radius:12px;background:rgba(168,255,120,0.15);border:2px solid rgba(168,255,120,0.5);box-shadow:0 0 12px rgba(168,255,120,0.3);">
          <span style="font-size: 22px; filter: drop-shadow(0 0 8px rgba(168,255,120,0.7));">🦎</span>
        </div>
        <div class="shadow-slot flex items-center justify-center" style="width:52px;height:52px;border-radius:12px;background:rgba(242,201,76,0.15);border:2px solid rgba(242,201,76,0.5);box-shadow:0 0 12px rgba(242,201,76,0.3);">
          <span style="font-size: 22px; filter: drop-shadow(0 0 8px rgba(242,201,76,0.7));">🐒</span>
        </div>
        <div class="shadow-slot flex items-center justify-center" id="sloth-slot" style="width:52px;height:52px;border-radius:12px;background:rgba(0,0,0,0.3);border:1.5px dashed rgba(0,210,255,0.2); transition: all 0.6s;">
          <span class="text-xl opacity-30">🦥</span>
        </div>
        <div class="shadow-slot flex items-center justify-center" style="width:52px;height:52px;border-radius:12px;background:rgba(0,0,0,0.3);border:1.5px dashed rgba(0,210,255,0.2);">
          <span class="text-xl opacity-20">✨</span>
        </div>
      </div>
    </div>
  </div>

  <script>lucide.createIcons();</script>

  <!-- ========== AUDIO & SPEECH ========== -->
  <script>
  const AudioCtx = window.AudioContext || window.webkitAudioContext;
  let audioCtx = null;
  function ensureAudio() {
    if (!audioCtx) audioCtx = new AudioCtx();
    if (audioCtx.state === 'suspended') audioCtx.resume();
  }
  function playTone(freq, dur=0.3, type='sine', vol=0.12) {
    ensureAudio();
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = type; o.frequency.value = freq;
    g.gain.setValueAtTime(vol, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); o.stop(audioCtx.currentTime + dur);
  }
  function playChime(freq) { playTone(freq, 0.3, 'sine', 0.08); }
  function playSuccess() { [523,659,784,1047].forEach((f,i)=>setTimeout(()=>playChime(f),i*120)); }
  function playSparkle() { [1200,1600,2000].forEach((f,i)=>setTimeout(()=>playTone(f,0.25,'sine',0.07),i*60)); }
  function playBuzz() {
    ensureAudio();
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = 'sawtooth';
    o.frequency.setValueAtTime(200, audioCtx.currentTime);
    o.frequency.linearRampToValueAtTime(100, audioCtx.currentTime+0.2);
    g.gain.setValueAtTime(0.1, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+0.25);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); o.stop(audioCtx.currentTime+0.25);
  }
  function playPop() {
    ensureAudio();
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(500, audioCtx.currentTime);
    o.frequency.exponentialRampToValueAtTime(200, audioCtx.currentTime+0.15);
    g.gain.setValueAtTime(0.12, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+0.2);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); o.stop(audioCtx.currentTime+0.2);
  }
  function playYawn() {
    ensureAudio();
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(220, audioCtx.currentTime);
    o.frequency.linearRampToValueAtTime(400, audioCtx.currentTime+0.4);
    o.frequency.linearRampToValueAtTime(180, audioCtx.currentTime+1.0);
    g.gain.setValueAtTime(0.06, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+1.1);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); o.stop(audioCtx.currentTime+1.1);
  }
  function playLaugh() {
    // "嘿嘿" laugh: quick descending tones
    [400, 350, 420, 360].forEach((f,i)=>setTimeout(()=>playTone(f,0.15,'triangle',0.08),i*120));
  }
  function playStretch() {
    ensureAudio();
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(180, audioCtx.currentTime);
    o.frequency.linearRampToValueAtTime(320, audioCtx.currentTime+0.6);
    g.gain.setValueAtTime(0.05, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime+0.7);
    o.connect(g); g.connect(audioCtx.destination);
    o.start(); o.stop(audioCtx.currentTime+0.7);
  }
  function playCorrect() {
    [659, 784, 1047].forEach((f,i)=>setTimeout(()=>playTone(f,0.15,'sine',0.08),i*100));
  }
  function playWrong() {
    [300, 250].forEach((f,i)=>setTimeout(()=>playTone(f,0.2,'sawtooth',0.08),i*150));
  }
  function speak(text, lang='zh-CN', rate=0.8) {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.lang = lang;
      u.rate = rate;
      u.pitch = 1.0;
      window.speechSynthesis.speak(u);
    }
  }

  // Generate bridge planks
  (function generatePlanks() {
    const deck = document.getElementById('bridge-deck');
    const count = 14;
    for (let i = 0; i < count; i++) {
      const plank = document.createElement('div');
      const w = (100 / count) - 1;
      plank.style.cssText = `flex: 1; height: 100%; background: linear-gradient(180deg, #8B6914 0%, #6b4423 40%, #4a3222 100%); border-radius: 3px; box-shadow: inset 0 -3px 6px rgba(0,0,0,0.4), 0 2px 4px rgba(0,0,0,0.3); position: relative;`;
      // Wood grain lines
      plank.innerHTML = `<div style="position:absolute;top:20%;left:10%;right:10%;height:1px;background:rgba(0,0,0,0.2);border-radius:1px;"></div>
                         <div style="position:absolute;top:50%;left:15%;right:15%;height:1px;background:rgba(0,0,0,0.15);border-radius:1px;"></div>
                         <div style="position:absolute;top:75%;left:5%;right:5%;height:1px;background:rgba(0,0,0,0.2);border-radius:1px;"></div>`;
      deck.appendChild(plank);
    }
  })();
  </script>

  <!-- ========== INTERACTION STATE MACHINE ========== -->
  <script>
  // ===== Shared progress/navigation helpers =====
  const ISLAND_ID = 'shadowJungle';
  const ISLAND_PAGE = 'shadow-jungle-v2.html';
  const WORLD_MAP = 'world-map-v2.html';
  const WORLD_MAP_PAGE = 'world-map-v2.html';
  const TOTAL_ANIMALS = 4;
  const ANIMAL_ID = 'sloth';
  const ISLAND_ANIMALS = ['monkey', 'chameleon', 'firefly', 'sloth'];

  function getCurrentPlayerId() {
    try {
      const raw = localStorage.getItem('starCarnivalDB');
      if (raw) {
        const db = JSON.parse(raw);
        if (db.currentPlayerId) return db.currentPlayerId;
      }
    } catch(e){}
    return localStorage.getItem('currentPlayerId');
  }

  function getProgress() {
    const cid = getCurrentPlayerId();
    if (!cid) return null;
    const key = 'starCarnival_progress_' + cid;
    let prog = {};
    try { prog = JSON.parse(localStorage.getItem(key) || '{}'); } catch(e) {}
    ['echoValley','bubbleBay','shadowJungle'].forEach(id => {
      if (!prog[id]) prog[id] = { completed: [], gemEarned: false };
      if (!prog[id].completed) prog[id].completed = [];
    });
    if (typeof prog.gems !== 'number') prog.gems = 0;
    if (!prog.unlocked) prog.unlocked = ['echoValley'];
    return prog;
  }

  function saveProgress(prog) {
    const cid = getCurrentPlayerId();
    if (!cid) return;
    localStorage.setItem('starCarnival_progress_' + cid, JSON.stringify(prog));
  }

  function markAnimalCompleted() {
    const prog = getProgress();
    if (!prog) return;
    if (!prog[ISLAND_ID].completed.includes(ANIMAL_ID)) {
      prog[ISLAND_ID].completed.push(ANIMAL_ID);
    }
    let g = 0;
    ['echoValley','bubbleBay','shadowJungle'].forEach(id => { if (prog[id].gemEarned) g++; });
    prog.gems = g;
    saveProgress(prog);
  }

  function navigateAfterRescue() {
    const prog = getProgress();
    if (!prog) {
      document.body.style.transition = 'opacity 0.3s';
      document.body.style.opacity = '0';
      setTimeout(() => { window.location.href = ISLAND_PAGE; }, 300);
      return;
    }
    if (!prog[ISLAND_ID].completed.includes(ANIMAL_ID)) {
      prog[ISLAND_ID].completed.push(ANIMAL_ID);
    }
    let g = 0;
    ['echoValley','bubbleBay','shadowJungle'].forEach(id => { if (prog[id].gemEarned) g++; });
    prog.gems = g;
      
      // Unlock sticker for this animal
      if (!prog.unlockedStickers) prog.unlockedStickers = [];
      if (!prog.unlockedStickers.includes(ANIMAL_ID)) {
        prog.unlockedStickers.push(ANIMAL_ID);
      }
      
      saveProgress(prog);
      const allDone = ISLAND_ANIMALS.every(a => prog[ISLAND_ID].completed.includes(a));
    document.body.style.transition = 'opacity 0.3s';
    document.body.style.opacity = '0';
    setTimeout(() => {
      window.location.href = allDone ? (WORLD_MAP_PAGE + '?islandComplete=' + ISLAND_ID) : ISLAND_PAGE;
    }, 300);
  }

  function navigateBack() {
    document.body.style.transition = 'opacity 0.25s';
    document.body.style.opacity = '0';
    setTimeout(() => { window.location.href = ISLAND_PAGE; }, 250);
  }

  // Wire back button
  document.querySelector('[data-dom-id="btn-back-to-map"]').addEventListener('click', navigateBack);

  let stage = 'paw-print'; // paw-print -> wake -> yawn -> long-press-intro -> pressing -> stretch -> fruit-cards -> complete
  let pressStartTime = 0;
  let pressTimer = null;
  let pressRafId = null;
  let isPressing = false;
  let funnyFaceTimer = null;
  const LONG_PRESS_DURATION = 5000; // 5 seconds

  const pawPrint = document.getElementById('paw-print');
  const slothContainer = document.getElementById('sloth-container');
  const slothFace = document.getElementById('sloth-face');
  const slothZzz = document.getElementById('sloth-zzz');
  const slothBelly = document.getElementById('sloth-belly');
  const slothBubble = document.getElementById('sloth-bubble');
  const bubbleText = document.getElementById('bubble-text');
  const hourglassWrap = document.getElementById('hourglass-wrap');
  const timerRing = document.getElementById('timer-ring');
  const timerText = document.getElementById('timer-text');
  const fruitCardsWrap = document.getElementById('fruit-cards-wrap');
  const fruitCards = document.getElementById('fruit-cards');
  const fruitInstruction = document.getElementById('fruit-instruction');
  const speechPrompt = document.getElementById('speech-prompt');
  const micBtn = document.getElementById('mic-btn');
  const volumeBar = document.getElementById('volume-bar');
  const successOverlay = document.getElementById('success-overlay');
  const pathOpen = document.getElementById('path-open');
  const slothSlot = document.getElementById('sloth-slot');
  const hintText = document.getElementById('hint-text');
  const hourglassIcon = document.getElementById('hourglass-icon');

  const RING_CIRC = 2 * Math.PI * 80; // ~502.65

  function setHint(text) {
    hintText.textContent = text;
    if (window.VoiceGuide && window.VoiceGuide.isEnabled && window.VoiceGuide.isEnabled()) {
      clearTimeout(window.voiceGuide_hintTimer);
      window.voiceGuide_hintTimer = setTimeout(function() {
        window.VoiceGuide.speak(text);
      }, 300);
    }
  }

  function showBubble(text, duration = 1500) {
    bubbleText.textContent = text;
    slothBubble.style.transform = 'translateX(-50%) scale(1)';
    setTimeout(() => {
      slothBubble.style.transform = 'translateX(-50%) scale(0)';
    }, duration);
  }

  // Funny faces sloth makes during long press (distraction)
  const funnyFaces = ['😜', '😛', '🙃', '😝', '🤪', '😋'];
  const normalFace = '🦥'; // 树懒 emoji，按住时显示
  const sleepingFace = '😴';

  // ===== STAGE 1: Click paw print to wake sloth =====
  pawPrint.addEventListener('click', () => {
    if (stage !== 'paw-print') return;
    stage = 'wake';
    ensureAudio();
    playPop();

    // Paw print fades
    pawPrint.style.transition = 'opacity 0.5s, transform 0.5s';
    pawPrint.style.opacity = '0';
    pawPrint.style.transform = 'scale(0.5)';
    pawPrint.style.pointerEvents = 'none';

    setHint('嘘...树懒在睡觉，轻轻叫醒它~');

    // Sloth wakes: Zzz fades, eyes slowly open
    setTimeout(() => {
      slothZzz.style.opacity = '0';
      slothZzz.style.animation = 'none';
      slothZzz.style.transition = 'opacity 0.6s';
      slothFace.textContent = '😳'; // slowly opening eyes
      slothFace.style.transform = 'scale(0.9)';
      playPop();

      setTimeout(() => {
        stage = 'yawn';
        slothFace.textContent = '🥱'; // yawn
        slothFace.style.transform = 'scale(1.1)';
        playYawn();
        showBubble('呼啊~', 500);
        setHint('树懒打了个大哈欠~');

        setTimeout(() => {
          // Sloth is now awake, looking at child
          slothFace.textContent = '🐨';
          // Wait no, sloth emoji is 🦥 but that's full body. Use a face.
          slothFace.textContent = '😊';
          slothFace.style.transform = 'scale(1)';
          stage = 'long-press-intro';
          setHint('长按树懒，耐心等它慢慢爬开~');
          showBubble('...要抱抱？', 500);

          setTimeout(() => {
            startLongPressPhase();
          }, 300);
        }, 300);
      }, 300);
    }, 400);
  });

  function startLongPressPhase() {
    // Show hourglass timer
    hourglassWrap.style.transform = 'translate(-50%, -50%) scale(1)';
    hourglassWrap.style.pointerEvents = 'auto';
    // Enable belly button
    slothBelly.style.pointerEvents = 'auto';
    slothBelly.style.background = 'radial-gradient(circle, rgba(242,201,76,0.2) 0%, transparent 70%)';
    setHint('按住树懒不要松开！坚持5秒~');

    // Attach press listeners (both mouse and touch)
    slothBelly.addEventListener('mousedown', onPressStart);
    slothBelly.addEventListener('touchstart', onPressStart, { passive: false });
    document.addEventListener('mouseup', onPressEnd);
    document.addEventListener('touchend', onPressEnd);
    document.addEventListener('touchcancel', onPressEnd);
    document.addEventListener('mousemove', onPressMove);
    document.addEventListener('touchmove', onPressMove, { passive: false });
  }

  function onPressStart(e) {
    if (stage !== 'long-press-intro' && stage !== 'pressing') return;
    e.preventDefault();
    isPressing = true;
    pressStartTime = Date.now();
    stage = 'pressing';
    slothFace.textContent = normalFace;
    slothFace.style.transform = 'scale(1)';
    playChime(500);

    // Schedule funny faces at random intervals
    scheduleFunnyFace();
    updateTimer();
  }

  let lastTouchX = 0, lastTouchY = 0;
  function onPressMove(e) {
    if (!isPressing) return;
    // Optional: check if finger moved too far from belly? We'll be lenient.
    if (e.touches && e.touches[0]) {
      lastTouchX = e.touches[0].clientX;
      lastTouchY = e.touches[0].clientY;
    }
  }

  function onPressEnd(e) {
    if (!isPressing) return;
    const elapsed = Date.now() - pressStartTime;
    isPressing = false;
    if (funnyFaceTimer) { clearTimeout(funnyFaceTimer); funnyFaceTimer = null; }
    if (pressRafId) { cancelAnimationFrame(pressRafId); pressRafId = null; }

    if (stage === 'pressing' && elapsed < LONG_PRESS_DURATION - 50) {
      // Released too early!
      stage = 'long-press-intro';
      resetTimer();
      slothFace.textContent = '😆';
      showBubble('嘿嘿~', 300);
      playLaugh();
      setHint('哎呀松开了！再试一次，按住不要动~');
      // Body wiggle
      slothContainer.style.animation = 'slothShake 0.4s ease-in-out';
      setTimeout(() => { slothContainer.style.animation = ''; slothFace.textContent = '😊'; }, 500);
    }
  }

  function resetTimer() {
    timerRing.style.strokeDashoffset = RING_CIRC;
    timerText.textContent = '5.0';
    hourglassIcon.style.animation = 'none';
  }

  function updateTimer() {
    if (!isPressing) return;
    const elapsed = Date.now() - pressStartTime;
    const progress = Math.min(1, elapsed / LONG_PRESS_DURATION);
    const remaining = Math.max(0, (LONG_PRESS_DURATION - elapsed) / 1000);
    timerRing.style.strokeDashoffset = RING_CIRC * (1 - progress);
    timerText.textContent = remaining.toFixed(1);
    hourglassIcon.style.animation = 'hourglassShake 0.5s ease-in-out infinite alternate';

    if (progress >= 1) {
      // Long press complete!
      isPressing = false;
      if (funnyFaceTimer) { clearTimeout(funnyFaceTimer); funnyFaceTimer = null; }
      onLongPressComplete();
      return;
    }
    pressRafId = requestAnimationFrame(updateTimer);
  }

  function scheduleFunnyFace() {
    if (!isPressing) return;
    const delay = 800 + Math.random() * 1200; // 0.8-2 seconds
    funnyFaceTimer = setTimeout(() => {
      if (!isPressing) return;
      // Make a funny face
      const face = funnyFaces[Math.floor(Math.random() * funnyFaces.length)];
      slothFace.textContent = face;
      slothFace.style.transform = 'scale(1.2) rotate(' + (Math.random()*20-10) + 'deg)';
      playPop();
      // Go back to normal after 600ms
      setTimeout(() => {
        if (isPressing) {
          slothFace.textContent = normalFace;
          slothFace.style.transform = 'scale(1) rotate(0deg)';
        }
      }, 600);
      scheduleFunnyFace();
    }, delay);
  }

  function onLongPressComplete() {
    stage = 'stretch';
    playSuccess();
    // Hide hourglass
    hourglassWrap.style.transform = 'translate(-50%, -50%) scale(0)';
    hourglassWrap.style.pointerEvents = 'none';
    slothBelly.style.pointerEvents = 'none';
    slothBelly.style.background = 'transparent';

    setHint('树懒伸懒腰啦~');
    slothFace.textContent = '🥱';
    slothFace.style.transform = 'scale(1.1)';
    playStretch();

    setTimeout(() => {
      slothFace.textContent = '💪';
      slothFace.style.transform = 'scale(1) rotate(-10deg)';
      showBubble('嗯~ 醒了~', 1800);

      setTimeout(() => {
        // Sloth slowly crawls to the right (off the bridge)
        stage = 'fruit-cards';
        slothFace.textContent = '🦥';
        slothContainer.style.transition = 'left 1.8s ease-in-out, transform 1.8s ease-in-out, opacity 0.8s';
        slothContainer.style.left = '85%';
        slothContainer.style.opacity = '0.9';
        setHint('树懒慢慢爬开了...');

        setTimeout(() => {
          // Fruit cards appear
          showFruitCards();
        }, 300);
      }, 1200);
    }, 1000);
  }

  // ===== STAGE 6: Fruit cards with speech =====
  const fruits = [
    { emoji: '🍎', name: '苹果', en: 'Apple' },
    { emoji: '🍌', name: '香蕉', en: 'Banana' },
    { emoji: '🍇', name: '葡萄', en: 'Grape' }
  ];
  let currentFruitIdx = 0;
  let recognition = null;
  let micActive = false;
  let audioStream = null;
  let micAnalyser = null;
  let micDataArray = null;
  let micAnimFrame = null;
  let volumeStarted = false; // 防止多次触发音量检测

  function showFruitCards() {
    setHint('点卡片，说出水果名字！');
    fruitCardsWrap.style.opacity = '1';
    fruitCardsWrap.style.pointerEvents = 'auto';

    fruits.forEach((fruit, idx) => {
      const card = document.createElement('button');
      card.className = 'fruit-card';
      card.dataset.idx = idx;
      card.style.cssText = `width: 85px; height: 110px; border-radius: 16px; background: linear-gradient(145deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05)); border: 2px solid rgba(161,136,127,0.4); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); cursor: pointer; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; transition: all 0.4s; -webkit-tap-highlight-color: transparent; box-shadow: 0 4px 16px rgba(0,0,0,0.3);`;
      // 一开始就显示水果名+英文名，让幼儿知道要说什么
      card.innerHTML = `
        <div style="font-size: 44px; line-height: 1;">${fruit.emoji}</div>
        <div class="fruit-name" style="font-size: 11px; font-weight: 700; color: rgba(224,224,224,0.9);">${fruit.name}</div>
        <div class="fruit-en" style="font-size: 10px; color: rgba(224,224,224,0.6);">${fruit.en}</div>
        <div class="card-check" style="font-size: 20px; opacity: 0; transition: opacity 0.3s;">✅</div>
      `;
      card.addEventListener('click', () => onFruitCardClick(idx, card));
      fruitCards.appendChild(card);
    });
  }

  let currentCard = null;
  let currentFruit = null;

  function onFruitCardClick(idx, card) {
    if (idx !== currentFruitIdx) {
      // Shake wrong card
      card.style.animation = 'cardShake 0.4s ease-in-out';
      playBuzz();
      setTimeout(() => { card.style.animation = ''; }, 400);
      return;
    }
    if (card.dataset.done === '1') return;

    const fruit = fruits[idx];
    currentFruit = fruit;
    currentCard = card;
    fruitInstruction.textContent = `点麦克风，说出"${fruit.name}"！`;
    playChime(600);

    // Highlight card
    card.style.borderColor = '#F2C94C';
    card.style.boxShadow = '0 0 24px rgba(242,201,76,0.5)';
    card.style.transform = 'scale(1.08)';

    // Show mic prompt
    speechPrompt.style.opacity = '1';
    speechPrompt.style.transform = 'translateX(-50%) scale(1)';
    speechPrompt.style.pointerEvents = 'auto';

    // Wire mic button click — user MUST click mic to start
    micBtn.onclick = () => startSpeechRecognition(fruit, card);
  }

  function startSpeechRecognition(fruit, card) {
    if (micActive) return;
    ensureAudio();
    micActive = true;

    // Mic visual feedback
    micBtn.style.boxShadow = '0 0 40px rgba(0,210,255,0.8), inset 0 0 20px rgba(0,210,255,0.3)';
    micBtn.style.transform = 'scale(1.1)';
    fruitInstruction.textContent = `听着呢... 说出"${fruit.name}"！`;

    // Try Web Speech API for actual word detection
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    let srStarted = false;
    if (SR) {
      try {
        recognition = new SR();
        recognition.lang = 'zh-CN';
        recognition.interimResults = false;
        recognition.maxAlternatives = 3;
        recognition.continuous = false;

        let gotResult = false;
        recognition.onresult = (event) => {
          gotResult = true;
          let said = '';
          for (let i = 0; i < event.results[0].length; i++) {
            said += event.results[0][i].transcript;
          }
          checkSpeechResult(said, fruit, card);
        };
        recognition.onerror = (e) => {
          // SR 失败时回退到音量检测（只触发一次）
          if (!gotResult && !volumeStarted) {
            volumeStarted = true;
            startVolumeDetection(fruit, card);
          }
        };
        recognition.onend = () => {
          // recognition 结束时如果还没结果，回退到音量检测（只触发一次）
          if (!gotResult && micActive && !volumeStarted) {
            volumeStarted = true;
            startVolumeDetection(fruit, card);
          }
        };
        recognition.start();
        srStarted = true;

        // Safety timeout: if nothing happens in 6s, accept as correct (kid tried)
        setTimeout(() => {
          if (micActive && !gotResult) {
            onFruitCorrect(fruit, card);
          }
        }, 6000);
      } catch (e) {
        srStarted = false;
      }
    }

    if (!srStarted) {
      // No SpeechRecognition available — use volume detection instead
      startVolumeDetection(fruit, card);
    }
  }

  async function startVolumeDetection(fruit, card) {
    try {
      audioStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const source = audioCtx.createMediaStreamSource(audioStream);
      micAnalyser = audioCtx.createAnalyser();
      micAnalyser.fftSize = 256;
      source.connect(micAnalyser);
      micDataArray = new Uint8Array(micAnalyser.frequencyBinCount);
      fruitInstruction.textContent = `说出"${fruit.name}"~`;
      detectVolumeForFruit(fruit, card);
    } catch (err) {
      // Mic permission denied or unavailable — accept tap as correct after brief delay
      fruitInstruction.textContent = '点击麦克风确认~';
      // Single tap-to-confirm fallback
      micBtn.onclick = () => onFruitCorrect(fruit, card);
    }
  }

  function detectVolumeForFruit(fruit, card) {
    if (!micActive || !micAnalyser) return;
    micAnalyser.getByteFrequencyData(micDataArray);
    // Use peak + low-freq average for reliable voice detection
    let peak = 0;
    const lowBins = Math.max(8, Math.floor(micDataArray.length / 3));
    let lowSum = 0;
    for (let i = 0; i < micDataArray.length; i++) {
      if (micDataArray[i] > peak) peak = micDataArray[i];
      if (i < lowBins) lowSum += micDataArray[i];
    }
    const lowAvg = lowSum / lowBins;
    const level = Math.min(1, peak / 130);
    volumeBar.style.width = (level * 100) + '%';

    // Trigger on either strong peak or clear low-freq voice
    if (peak > 55 || lowAvg > 30) {
      onFruitCorrect(fruit, card);
      return;
    }
    micAnimFrame = requestAnimationFrame(() => detectVolumeForFruit(fruit, card));
  }

  function checkSpeechResult(said, fruit, card) {
    // Be lenient for kids — any recognized speech counts as success
    const clean = said.replace(/\s+/g, '').toLowerCase();
    const target = fruit.name.toLowerCase();
    const enTarget = fruit.en.toLowerCase();
    if (clean.includes(target) || clean.includes(enTarget) || said.length > 0) {
      onFruitCorrect(fruit, card);
    } else {
      playWrong();
      fruitInstruction.textContent = '再试试~ 说"' + fruit.name + '"';
      setTimeout(() => {
        // Reset mic state and allow retry
        cleanupMic();
        startSpeechRecognition(fruit, card);
      }, 300);
    }
  }

  function cleanupMic() {
    micActive = false;
    volumeStarted = false; // 重置回退标志，为下一轮准备
    if (micAnimFrame) { cancelAnimationFrame(micAnimFrame); micAnimFrame = null; }
    if (audioStream) {
      audioStream.getTracks().forEach(t => t.stop());
      audioStream = null;
    }
    if (recognition) {
      try { recognition.stop(); } catch(e){}
      recognition = null;
    }
    micBtn.style.boxShadow = '';
    micBtn.style.transform = '';
    volumeBar.style.width = '0%';
  }

  function onFruitCorrect(fruit, card) {
    if (card.dataset.done === '1') return;
    card.dataset.done = '1';
    cleanupMic();
    playCorrect();

    // Mark card as done — 名字已显示，只改颜色和勾选
    const nameEl = card.querySelector('.fruit-name');
    if (nameEl) {
      nameEl.style.color = '#A8FF78';
    }
    card.querySelector('.card-check').style.opacity = '1';
    card.style.borderColor = '#A8FF78';
    card.style.boxShadow = '0 0 20px rgba(168,255,120,0.5)';
    card.style.transform = 'scale(1)';

    // Sloth nods
    slothFace.textContent = '😊';
    showBubble('👍', 1000);

    // Hide mic prompt
    speechPrompt.style.opacity = '0';
    speechPrompt.style.transform = 'translateX(-50%) scale(0.7)';
    speechPrompt.style.pointerEvents = 'none';

    currentFruitIdx++;
    if (currentFruitIdx >= fruits.length) {
      // All fruits done!
      setTimeout(() => onAllFruitsComplete(), 300);
    } else {
      fruitInstruction.textContent = `下一个！点卡片说出名字~`;
      setHint('很棒！下一个水果~');
    }
  }

  function onAllFruitsComplete() {
    stage = 'complete';
    setHint('树懒满意地点点头，让路啦！');
    fruitCardsWrap.style.opacity = '0';
    fruitCardsWrap.style.pointerEvents = 'none';

    // Sloth nods, crawls all the way off
    slothFace.textContent = '😊';
    slothContainer.style.transition = 'left 1.5s ease-in-out, opacity 1s';
    slothContainer.style.left = '105%';
    slothContainer.style.opacity = '0';
    playSuccess();

    setTimeout(() => {
      // Path opens
      pathOpen.style.opacity = '1';
      spawnConfetti();
      showSuccess(); if(window.StarGuide) window.StarGuide.nextStep();
    }, 1200);
  }

  function showSuccess() {
    // Fill sloth slot
    slothSlot.style.background = 'rgba(161,136,127,0.2)';
    slothSlot.style.border = '2px solid rgba(161,136,127,0.5)';
    slothSlot.style.boxShadow = '0 0 16px rgba(161,136,127,0.4)';
    const slotSpan = slothSlot.querySelector('span');
    slotSpan.style.opacity = '1';
    slotSpan.style.filter = 'drop-shadow(0 0 8px rgba(161,136,127,0.7))';

    // Update friend count
    const friendCount = document.getElementById('friend-count');
    if (friendCount) friendCount.textContent = '朋友 5/10';
    const shadowCount = document.getElementById('shadow-count');
    if (shadowCount) shadowCount.textContent = '影子收集 2/4';

    // Fill a star
    const emptyStars = document.querySelectorAll('.star-gem-empty');
    if (emptyStars[0]) {
      emptyStars[0].textContent = '★';
      emptyStars[0].style.color = '#D7CCC8';
      emptyStars[0].className = 'star-gem-filled';
      emptyStars[0].style.textShadow = '0 0 8px rgba(161,136,127,0.8), 0 0 16px rgba(161,136,127,0.5)';
    }

    successOverlay.style.opacity = '1';
    // STARLIGHT_SUCCESS_FEEDBACK
    setTimeout(function() {
      if (window.VoiceGuide) {
        window.VoiceGuide.speak("太棒了！树懒吃饱了！你真是有爱心的小朋友！");
      }
      setTimeout(function() {
        var btn = document.getElementById('btn-continue-adventure');
        if (btn && window.GestureGuide) {
          window.GestureGuide.showTap(btn, { id: 'shadow-jungle-sloth_continue', duration: 4000, once: false });
        }
      }, 1500);
    }, 500);
    successOverlay.style.pointerEvents = 'auto';

    // Wire continue button
    const continueBtn = document.getElementById('btn-continue-adventure');
    if (continueBtn) {
      continueBtn.addEventListener('click', navigateAfterRescue);
    }
  }

  // Confetti
  function spawnConfetti() {
    const container = document.getElementById('confetti-container');
    const colors = ['#A8FF78', '#F2C94C', '#00D2FF', '#CE93D8', '#FF7675', '#8D6E63'];
    const emojis = ['🍃', '🌿', '✨', '🍎', '🍌', '🍇'];
    for (let i = 0; i < 30; i++) {
      const c = document.createElement('div');
      const isEmoji = Math.random() > 0.5;
      c.style.cssText = `position: fixed; left: ${Math.random()*100}%; top: -30px; font-size: ${isEmoji ? 20+Math.random()*16 : 8+Math.random()*8}px; ${isEmoji ? '' : 'width:'+ (6+Math.random()*8) + 'px;height:' + (6+Math.random()*8) + 'px;background:' + colors[Math.floor(Math.random()*colors.length)] + ';border-radius:' + (Math.random()>0.5?'50%':'2px') + ';'}; pointer-events: none; z-index: 50;`;
      c.textContent = isEmoji ? emojis[Math.floor(Math.random()*emojis.length)] : '';
      container.appendChild(c);
      const dur = 2 + Math.random()*2;
      const xDrift = (Math.random()-0.5)*200;
      c.animate([
        { transform: 'translate(0,0) rotate(0deg)', opacity: 1 },
        { transform: `translate(${xDrift}px, 100vh) rotate(${Math.random()*720}deg)`, opacity: 0 }
      ], { duration: dur*1000, easing: 'cubic-bezier(0.25,0.46,0.45,0.94)' });
      setTimeout(() => c.remove(), dur*1000);
    }
  }
  </script>

  <!-- ========== ANIMATIONS ========== -->
  <style>
    .star-gem-empty {
      color: #00D2FF;
      opacity: 0.3;
      text-shadow: 0 0 4px rgba(0,210,255,0.3);
      transition: all 0.5s;
    }
    .star-gem-filled {
      color: #D7CCC8;
      opacity: 1;
      transition: all 0.5s;
    }
    .ff-dot {
      position: absolute;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--c, #A8FF78);
      box-shadow: 0 0 6px 2px color-mix(in srgb, var(--c) 40%, transparent), 0 0 14px 4px color-mix(in srgb, var(--c) 15%, transparent);
      animation: ff-drift 8s ease-in-out infinite, ff-flicker 3s ease-in-out infinite;
      animation-delay: var(--d, 0s);
    }
    @keyframes ff-drift {
      0%,100% { transform: translate(0,0) scale(1); }
      25% { transform: translate(15px,-20px) scale(1.2); }
      50% { transform: translate(-10px,-30px) scale(0.7); }
      75% { transform: translate(20px,-15px) scale(1.1); }
    }
    @keyframes ff-flicker {
      0%,100% { opacity: 0.2; }
      40% { opacity: 1; }
      60% { opacity: 0.5; }
    }
    @keyframes pawPulse {
      0%,100% { transform: scale(1); opacity: 0.5; }
      50% { transform: scale(1.2); opacity: 0.9; }
    }
    @keyframes zzzFloat {
      0%,100% { transform: translateY(0) scale(1); opacity: 0.6; }
      50% { transform: translateY(-8px) scale(1.1); opacity: 1; }
    }
    @keyframes hourglassShake {
      0% { transform: rotate(-3deg); }
      100% { transform: rotate(3deg); }
    }
    @keyframes slothShake {
      0%,100% { transform: translateX(-50%) translateX(0); }
      25% { transform: translateX(-50%) translateX(-8px) rotate(-2deg); }
      75% { transform: translateX(-50%) translateX(8px) rotate(2deg); }
    }
    @keyframes cardShake {
      0%,100% { transform: translateX(0); }
      25% { transform: translateX(-8px) rotate(-3deg); }
      75% { transform: translateX(8px) rotate(3deg); }
    }
    @keyframes pathGlow {
      0%,100% { transform: scale(1); opacity: 0.7; }
      50% { transform: scale(1.15); opacity: 1; }
    }
    @keyframes nextPulse {
      0%,100% { transform: scale(1); box-shadow: 0 4px 20px rgba(168,255,120,0.5); }
      50% { transform: scale(1.06); box-shadow: 0 6px 28px rgba(168,255,120,0.8); }
    }
    @keyframes continuePulse {
      0%, 100% { transform: scale(1); box-shadow: 0 0 24px rgba(168,255,120,0.5), 0 4px 20px rgba(0,210,255,0.4); }
      50% { transform: scale(1.06); box-shadow: 0 0 36px rgba(168,255,120,0.8), 0 6px 28px rgba(0,210,255,0.6), 0 0 48px rgba(206,147,216,0.4); }
    }
    @keyframes success-bounce {
      0% { transform: scale(0); }
      60% { transform: scale(1.2); }
      100% { transform: scale(1); }
    }
    #btn-continue-adventure:active {
      transform: scale(0.95) !important;
      filter: brightness(1.1);
    }
    @media (prefers-reduced-motion: reduce) {
      .ff-dot { animation: none; }
    }
  </style>
<script>
// Load current player from localStorage
(function(){
  try {
    const raw = localStorage.getItem('starCarnivalDB');
    if (!raw) return;
    const db = JSON.parse(raw);
    const cid = db.currentPlayerId || localStorage.getItem('currentPlayerId');
    if (!cid || !db.players) return;
    const p = db.players.find(x => x.id === cid);
    if (!p) return;
    const av = document.getElementById('player-av');
    const nm = document.getElementById('player-nm');
    if (av) av.textContent = p.avatar || '⭐';
    if (nm) nm.textContent = p.name || '小探险家';
  } catch(e){}
})();
</script>

  <script>
  // 页面自动朗读
  (function() {
    const AUTO_SPEAK_WELCOME = '可爱的树懒朋友！按住树懒，给它喂水果吧！';
    
    function trySpeakWelcome() {
      if (window.VoiceGuide && typeof window.VoiceGuide.speak === 'function') {
        setTimeout(function() {
          window.VoiceGuide.speak(AUTO_SPEAK_WELCOME);
        }, 300);
      } else {
        setTimeout(trySpeakWelcome, 200);
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', trySpeakWelcome);
    } else {
      trySpeakWelcome();
    }
  })();
  </script>


  <script>
  // 语音引导增强：点击文字朗读 + 关键提示自动朗读
  (function() {
    // 等待 VoiceGuide 就绪
    function waitForVoiceGuide(callback) {
      if (window.VoiceGuide) {
        callback();
      } else {
        setTimeout(function() { waitForVoiceGuide(callback); }, 100);
      }
    }
    
    waitForVoiceGuide(function() {
      // 给所有提示类元素添加点击朗读
      function addClickSpeak(selector) {
        var els = document.querySelectorAll(selector);
        els.forEach(function(el) {
          el.style.cursor = 'pointer';
          el.addEventListener('click', function(e) {
            e.stopPropagation();
            var text = el.textContent || el.innerText;
            if (text && text.trim()) {
              window.VoiceGuide.speak(text.trim());
            }
          });
        });
      }
      
      // 常见的提示文字选择器
      var selectors = [
        '#hint-text',
        '#hint-banner',
        '#error-hint-text',
        '#mic-status',
        '#mic-hint',
        '#friction-hint',
        '.hint-text',
        '.tip-text',
        '#gem-title',
        '#gem-subtitle'
      ];
      
      selectors.forEach(function(sel) {
        addClickSpeak(sel);
      });
      
      // 自动朗读初始的 hint-text
      var initialHint = document.querySelector('#hint-text, .hint-text');
      if (initialHint && initialHint.textContent.trim()) {
        setTimeout(function() {
          window.VoiceGuide.speak(initialHint.textContent.trim());
        }, 300);
      }
    });
  })();
  </script>


  <script>
  // 引导手势动画系统
  window.GestureGuide = {
    STORAGE_KEY: 'starlight_gesture_seen',
    
    // 检查是否已经看过某个手势
    hasSeen: function(id) {
      try {
        var seen = JSON.parse(localStorage.getItem(this.STORAGE_KEY) || '{}');
        return seen[id] === true;
      } catch(e) { return false; }
    },
    
    // 标记已看过
    markSeen: function(id) {
      try {
        var seen = JSON.parse(localStorage.getItem(this.STORAGE_KEY) || '{}');
        seen[id] = true;
        localStorage.setItem(this.STORAGE_KEY, JSON.stringify(seen));
      } catch(e) {}
    },
    
    // 移除手势
    remove: function(overlay) {
      if (overlay && overlay.parentNode) {
        overlay.style.opacity = '0';
        overlay.style.transition = 'opacity 0.3s';
        setTimeout(function() {
          if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
        }, 300);
      }
    },
    
    // === 点击手势 ===
    showTap: function(targetEl, options) {
      var opts = options || {};
      var id = opts.id || 'tap_' + Date.now();
      var once = opts.once !== false;
      var duration = opts.duration || 3000;
      var onComplete = opts.onComplete;
      
      if (once && this.hasSeen(id)) return null;
      
      var rect = targetEl.getBoundingClientRect();
      var overlay = document.createElement('div');
      overlay.className = 'gesture-overlay';
      
      
      // 手指 emoji
      var hand = document.createElement('div');
      hand.className = 'gesture-hand gesture-tap-anim';
      hand.textContent = '👆';
      hand.style.left = (rect.left + rect.width / 2) + 'px';
      hand.style.top = (rect.top + rect.height / 2) + 'px';
      hand.style.fontSize = opts.size || '80px';
      overlay.appendChild(hand);
      
      // 涟漪
      var ripple = document.createElement('div');
      ripple.className = 'gesture-ripple gesture-ripple-anim';
      ripple.style.left = (rect.left + rect.width / 2) + 'px';
      ripple.style.top = (rect.top + rect.height / 2) + 'px';
      overlay.appendChild(ripple);
      
      document.body.appendChild(overlay);
      
      var self = this;
      var timer = setTimeout(function() {
        self.remove(overlay);
        if (once) self.markSeen(id);
        if (onComplete) onComplete();
      }, duration);
      
      overlay._timer = timer;
      return overlay;
    },
    
    // === 拖拽手势 ===
    showDrag: function(fromEl, toEl, options) {
      var opts = options || {};
      var id = opts.id || 'drag_' + Date.now();
      var once = opts.once !== false;
      var duration = opts.duration || 4000;
      var onComplete = opts.onComplete;
      
      if (once && this.hasSeen(id)) return null;
      
      var fromRect = fromEl.getBoundingClientRect();
      var toRect = toEl.getBoundingClientRect();
      
      var overlay = document.createElement('div');
      overlay.className = 'gesture-overlay';
      
      
      var hand = document.createElement('div');
      hand.className = 'gesture-hand';
      hand.textContent = '👆';
      hand.style.fontSize = opts.size || '72px';
      hand.style.position = 'absolute';
      hand.style.top = (fromRect.top + fromRect.height / 2) + 'px';
      hand.style.left = (fromRect.left + fromRect.width / 2) + 'px';
      hand.style.opacity = '0';
      hand.style.transform = 'translate(-50%,-50%)';
      hand.style.transition = 'none';
      overlay.appendChild(hand);
      
      document.body.appendChild(overlay);
      
      // 动画序列：出现→拖到目标→放下→消失
      var steps = [
        { t: 0,    opacity: 0,   x: fromRect.left + fromRect.width/2, y: fromRect.top + fromRect.height/2, scale: 1.3 },
        { t: 300,  opacity: 1, x: fromRect.left + fromRect.width/2, y: fromRect.top + fromRect.height/2, scale: 1 },
        { t: 1800, opacity: 1, x: toRect.left + toRect.width/2, y: toRect.top + toRect.height/2, scale: 1 },
        { t: 2200, opacity: 1, x: toRect.left + toRect.width/2, y: toRect.top + toRect.height/2, scale: 0.85 },
        { t: 2500, opacity: 1, x: toRect.left + toRect.width/2, y: toRect.top + toRect.height/2, scale: 1 },
        { t: 3000, opacity: 0,   x: toRect.left + toRect.width/2, y: toRect.top + toRect.height/2, scale: 1 },
      ];
      
      var startTime = null;
      function animate(now) {
        if (!startTime) startTime = now;
        var elapsed = now - startTime;
        
        // 找到当前所在的两个关键帧
        var prev = steps[0], next = steps[steps.length - 1];
        for (var i = 0; i < steps.length - 1; i++) {
          if (elapsed >= steps[i].t && elapsed < steps[i+1].t) {
            prev = steps[i]; next = steps[i+1]; break;
          }
        }
        if (elapsed >= steps[steps.length-1].t) {
          prev = next = steps[steps.length-1];
        }
        
        var progress = (next.t === prev.t) ? 1 : (elapsed - prev.t) / (next.t - prev.t);
        var ease = progress < 0.5 ? 2*progress*progress : -1+(4-2*progress)*progress;
        
        var curX = prev.x + (next.x - prev.x) * ease;
        var curY = prev.y + (next.y - prev.y) * ease;
        var curOp = prev.opacity + (next.opacity - prev.opacity) * ease;
        var curScale = prev.scale + (next.scale - prev.scale) * ease;
        
        hand.style.left = curX + 'px';
        hand.style.top = curY + 'px';
        hand.style.opacity = curOp;
        hand.style.transform = 'translate(-50%,-50%) scale(' + curScale + ')';
        
        if (elapsed < duration) {
          requestAnimationFrame(animate);
        } else {
          GestureGuide.remove(overlay);
          if (once) GestureGuide.markSeen(id);
          if (onComplete) onComplete();
        }
      }
      requestAnimationFrame(animate);
      
      return overlay;
    },
    
    // === 双指摩擦手势 ===
    showRub: function(targetEl, options) {
      var opts = options || {};
      var id = opts.id || 'rub_' + Date.now();
      var once = opts.once !== false;
      var duration = opts.duration || 3500;
      var cycles = opts.cycles || 3;
      var onComplete = opts.onComplete;
      
      if (once && this.hasSeen(id)) return null;
      
      var rect = targetEl.getBoundingClientRect();
      var overlay = document.createElement('div');
      overlay.className = 'gesture-overlay';
      
      
      // 左手
      var handL = document.createElement('div');
      handL.className = 'gesture-hand';
      handL.textContent = '👆';
      handL.style.fontSize = '64px';
      handL.style.position = 'absolute';
      handL.style.top = (rect.top + rect.height / 2 - 10) + 'px';
      handL.style.left = (rect.left + rect.width / 2 - 20) + 'px';
      handL.style.opacity = '0.9';
      handL.style.transform = 'translate(-50%,-50%)';
      overlay.appendChild(handL);
      
      // 右手
      var handR = document.createElement('div');
      handR.className = 'gesture-hand';
      handR.textContent = '👆';
      handR.style.fontSize = '64px';
      handR.style.position = 'absolute';
      handR.style.top = (rect.top + rect.height / 2 + 10) + 'px';
      handR.style.left = (rect.left + rect.width / 2 + 20) + 'px';
      handR.style.opacity = '0.9';
      handR.style.transform = 'translate(-50%,-50%)';
      overlay.appendChild(handR);
      
      document.body.appendChild(overlay);
      
      // 来回搓动
      var rubDuration = 600; // 每次来回 600ms
      var totalRubTime = rubDuration * cycles;
      var startTime = null;
      var fadeStart = totalRubTime + 500;
      
      function animate(now) {
        if (!startTime) startTime = now;
        var elapsed = now - startTime;
        
        if (elapsed < totalRubTime) {
          // 搓动阶段
          var phase = (elapsed % rubDuration) / rubDuration;
          var offset = Math.sin(phase * Math.PI * 2) * 26;
          handL.style.transform = 'translate(calc(-50% + ' + (-offset) + 'px), -50%)';
          handR.style.transform = 'translate(calc(-50% + ' + offset + 'px), -50%)';
          handL.style.opacity = '0.9';
          handR.style.opacity = '0.9';
        } else if (elapsed < fadeStart) {
          // 搓完停留
          handL.style.opacity = '0.9';
          handR.style.opacity = '0.9';
        } else {
          // 淡出
          var fadeProgress = (elapsed - fadeStart) / (duration - fadeStart);
          var fadeOp = Math.max(0, 0.65 * (1 - fadeProgress));
          handL.style.opacity = fadeOp;
          handR.style.opacity = fadeOp;
        }
        
        if (elapsed < duration) {
          requestAnimationFrame(animate);
        } else {
          GestureGuide.remove(overlay);
          if (once) GestureGuide.markSeen(id);
          if (onComplete) onComplete();
        }
      }
      requestAnimationFrame(animate);
      
      return overlay;
    },
    
    // === 按住手势 ===
    showPress: function(targetEl, options) {
      var opts = options || {};
      var id = opts.id || 'press_' + Date.now();
      var once = opts.once !== false;
      var duration = opts.duration || 3000;
      var onComplete = opts.onComplete;
      
      if (once && this.hasSeen(id)) return null;
      
      var rect = targetEl.getBoundingClientRect();
      var overlay = document.createElement('div');
      overlay.className = 'gesture-overlay';
      
      
      var hand = document.createElement('div');
      hand.className = 'gesture-hand gesture-press-anim';
      hand.textContent = '👇';
      hand.style.left = (rect.left + rect.width / 2) + 'px';
      hand.style.top = (rect.top + rect.height / 2) + 'px';
      hand.style.fontSize = opts.size || '80px';
      overlay.appendChild(hand);
      
      document.body.appendChild(overlay);
      
      var self = this;
      setTimeout(function() {
        self.remove(overlay);
        if (once) self.markSeen(id);
        if (onComplete) onComplete();
      }, duration);
      
      return overlay;
    },
    
    // === 喊叫手势 ===
    showShout: function(targetEl, options) {
      var opts = options || {};
      var id = opts.id || 'shout_' + Date.now();
      var once = opts.once !== false;
      var duration = opts.duration || 3000;
      var onComplete = opts.onComplete;
      
      if (once && this.hasSeen(id)) return null;
      
      var rect = targetEl.getBoundingClientRect();
      var overlay = document.createElement('div');
      overlay.className = 'gesture-overlay';
      
      
      // 嘴巴 emoji 靠近麦克风
      var mouth = document.createElement('div');
      mouth.className = 'gesture-hand';
      mouth.textContent = '📢';
      mouth.style.left = (rect.left + rect.width / 2) + 'px';
      mouth.style.top = (rect.top - 40) + 'px';
      mouth.style.fontSize = '64px';
      mouth.style.opacity = '0';
      mouth.style.transform = 'translate(-50%,-50%)';
      overlay.appendChild(mouth);
      
      // 声波效果
      for (var i = 1; i <= 3; i++) {
        var wave = document.createElement('div');
        wave.style.position = 'absolute';
        wave.style.left = (rect.left + rect.width / 2) + 'px';
        wave.style.top = (rect.top - 20) + 'px';
        wave.style.width = (20 + i * 15) + 'px';
        wave.style.height = (20 + i * 15) + 'px';
        wave.style.borderRadius = '50%';
        wave.style.border = '2px solid rgba(242,201,76,0.4)';
        wave.style.opacity = '0';
        wave.style.transform = 'translate(-50%,-50%)';
        wave.style.pointerEvents = 'none';
        wave._delay = i * 200;
        wave._index = i;
        overlay.appendChild(wave);
      }
      
      document.body.appendChild(overlay);
      
      var startTime = null;
      function animate(now) {
        if (!startTime) startTime = now;
        var elapsed = now - startTime;
        var progress = elapsed / duration;
        
        // 嘴巴淡入淡出
        if (progress < 0.15) {
          mouth.style.opacity = (progress / 0.15) * 0.7;
        } else if (progress < 0.8) {
          mouth.style.opacity = '1';
        } else {
          mouth.style.opacity = Math.max(0, 0.7 * (1 - (progress - 0.8) / 0.2));
        }
        
        // 声波扩散
        var children = overlay.children;
        for (var i = 1; i < children.length; i++) {
          var w = children[i];
          if (!w._delay) continue;
          var wElapsed = elapsed - w._delay;
          if (wElapsed > 0 && wElapsed < 1500) {
            var wProgress = (wElapsed % 800) / 800;
            w.style.opacity = Math.max(0, 0.4 * (1 - wProgress));
            var wScale = 1 + wProgress * 1.5;
            w.style.transform = 'translate(-50%,-50%) scale(' + wScale + ')';
          } else {
            w.style.opacity = '0';
          }
        }
        
        if (elapsed < duration) {
          requestAnimationFrame(animate);
        } else {
          GestureGuide.remove(overlay);
          if (once) GestureGuide.markSeen(id);
          if (onComplete) onComplete();
        }
      }
      requestAnimationFrame(animate);
      
      return overlay;
    }
  };
  </script>


  <script>
  // GESTURE_TRIGGER_sloth - 页面专属手势引导
  (function() {
    function waitAndShow() {
      if (window.GestureGuide) {
        
    var checkSloth = setInterval(function() {
      var sloth = document.getElementById('sloth-btn') || document.querySelector('.sloth-area');
      if (sloth && !GestureGuide.hasSeen('sloth_press')) {
        clearInterval(checkSloth);
        setTimeout(function() {
          GestureGuide.showPress(sloth, { id: 'sloth_press', duration: 3000, once: false });
        }, 300);
      }
    }, 500);
    
      } else {
        setTimeout(waitAndShow, 200);
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() { setTimeout(waitAndShow, 500); });
    } else {
      setTimeout(waitAndShow, 500);
    }
  })();
  </script>


  <!-- ========== 语音旁白系统 ========== -->
  <button id="voice-settings-btn" class="voice-settings-btn" aria-label="语音设置">🔊</button>
  <div id="voice-settings-panel" class="voice-settings-panel">
    <div class="voice-settings-title">游戏设置</div>
    <div class="voice-setting-row">
      <span class="voice-setting-label">语音引导</span>
      <button id="voice-guide-toggle" class="voice-toggle on" aria-label="语音引导开关"></button>
    </div>
    <div class="voice-setting-row" style="border-top: 1px solid rgba(255,255,255,0.1); margin-top: 8px; padding-top: 12px;">
      <span class="voice-setting-label">重置手势演示</span>
      <button id="reset-gesture-btn" style="background: rgba(255,200,60,0.3); border: 1px solid rgba(255,200,60,0.5); color: #FFC048; padding: 4px 10px; border-radius: 8px; font-size: 11px; cursor: pointer;">重置</button>
    </div>
  </div>
  <script>
  (function() {
    const STORAGE_KEY = 'starlight_voice_guide';
    const synth = window.speechSynthesis;
    
    function isVoiceGuideEnabled() {
      const v = localStorage.getItem(STORAGE_KEY);
      return v !== 'false';
    }
    
    function setVoiceGuideEnabled(enabled) {
      localStorage.setItem(STORAGE_KEY, enabled ? 'true' : 'false');
      updateBtnIcon();
      if (enabled) {
        speakGuide('语音引导已开启');
      }
    }
    
    function updateBtnIcon() {
      const btn = document.getElementById('voice-settings-btn');
      if (!btn) return;
      if (isVoiceGuideEnabled()) {
        btn.textContent = '🔊';
        btn.classList.remove('muted');
      } else {
        btn.textContent = '🔇';
        btn.classList.add('muted');
      }
    }
    
    let currentUtterance = null;
    
    function stopSpeak() {
      if (synth && synth.speaking) {
        synth.cancel();
      }
      currentUtterance = null;
    }
    
    function speakGuide(text, options) {
      if (!isVoiceGuideEnabled()) return;
      if (!synth) return;
      if (!text || !text.trim()) return;
      
      stopSpeak();
      
      const opts = options || {};
      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = 'zh-CN';
      utter.rate = opts.rate || 0.9;
      utter.pitch = opts.pitch || 1.3;
      utter.volume = opts.volume || 1;
      
      const voices = synth.getVoices();
      const zhVoice = voices.find(function(v) {
        return v.lang && v.lang.toLowerCase().indexOf('zh') === 0;
      });
      if (zhVoice) utter.voice = zhVoice;
      
      currentUtterance = utter;
      synth.speak(utter);
    }
    
    function speakEn(text, options) {
      if (!isVoiceGuideEnabled()) return;
      if (!synth) return;
      
      stopSpeak();
      
      const opts = options || {};
      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = 'en-US';
      utter.rate = opts.rate || 0.8;
      utter.pitch = opts.pitch || 1.2;
      utter.volume = opts.volume || 1;
      
      currentUtterance = utter;
      synth.speak(utter);
    }
    
    document.addEventListener('DOMContentLoaded', function() {
      const btn = document.getElementById('voice-settings-btn');
      const panel = document.getElementById('voice-settings-panel');
      const toggle = document.getElementById('voice-guide-toggle');
      const resetBtn = document.getElementById('reset-gesture-btn');
      
      updateBtnIcon();
      if (isVoiceGuideEnabled()) {
        if (toggle) toggle.classList.add('on');
      } else {
        if (toggle) toggle.classList.remove('on');
      }
      
      if (btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          if (panel) panel.classList.toggle('show');
        });
      }
      
      document.addEventListener('click', function(e) {
        if (panel && !panel.contains(e.target) && e.target !== btn) {
          panel.classList.remove('show');
        }
      });
      
      if (toggle) {
        toggle.addEventListener('click', function() {
          const enabled = !isVoiceGuideEnabled();
          setVoiceGuideEnabled(enabled);
          if (enabled) {
            toggle.classList.add('on');
          } else {
            toggle.classList.remove('on');
          }
        });
      }
      
      if (resetBtn) {
        resetBtn.addEventListener('click', function() {
          try {
            localStorage.removeItem('starlight_gesture_seen');
            alert('手势演示已重置！刷新页面即可重新看到引导动画。');
          } catch(e) {}
        });
      }
      
      if (synth) {
        synth.getVoices();
        window.addEventListener('voiceschanged', function() {
          synth.getVoices();
        });
      }
    });
    
    window.VoiceGuide = {
      speak: speakGuide,
      speakEn: speakEn,
      stop: stopSpeak,
      isEnabled: isVoiceGuideEnabled
    };
  })();
  </script>


  <!-- ========== 小星星向导 ========== -->
  <div id="star-guide-container" class="star-guide-container">
    <div id="star-guide-balloon" class="star-guide-balloon"></div>
    <div id="star-guide" class="star-guide" title="小星星向导">⭐</div>
  </div>
  <script>
  // 小星星向导系统
  window.StarGuide = {
    container: null,
    star: null,
    balloon: null,
    currentStep: 0,
    idleTimer: null,
    idleTimeout: 3000,
    isFlying: false,
    targetGlow: null,
    
    // 每个页面的引导步骤配置
    steps: [],
    
    init: function(stepsConfig) {
      this.container = document.getElementById('star-guide-container');
      this.star = document.getElementById('star-guide');
      this.balloon = document.getElementById('star-guide-balloon');
      this.steps = stepsConfig || [];
      this.currentStep = 0;
      
      if (!this.container || !this.star || !this.balloon) return;
      
      var self = this;
      
      // 星星点击事件
      this.star.addEventListener('click', function() {
        self.showCurrentStep();
      });
      
      // 监听用户操作（重置空闲计时器）
      document.addEventListener('mousedown', function() { self.resetIdleTimer(); });
      document.addEventListener('touchstart', function() { self.resetIdleTimer(); });
      document.addEventListener('pointerdown', function() { self.resetIdleTimer(); });
      
      // 启动空闲检测
      this.startIdleTimer();
      
      // 页面加载完成后，延迟显示星星
      setTimeout(function() {
        self.container.classList.remove('hidden');
      }, 500);
    },
    
    startIdleTimer: function() {
      var self = this;
      this.idleTimer = setTimeout(function() {
        self.onIdle();
      }, this.idleTimeout);
    },
    
    resetIdleTimer: function() {
      if (this.idleTimer) {
        clearTimeout(this.idleTimer);
      }
      this.startIdleTimer();
      // 隐藏气球
      this.hideBalloon();
    },
    
    onIdle: function() {
      if (this.isFlying) return;
      if (this.currentStep >= this.steps.length) return;
      
      var step = this.steps[this.currentStep];
      if (!step) return;
      
      // 如果步骤需要等待某个条件，则检查
      if (step.condition && !step.condition()) {
        this.startIdleTimer();
        return;
      }
      
      this.showCurrentStep();
    },
    
    showCurrentStep: function() {
      if (this.currentStep >= this.steps.length) return;
      
      var step = this.steps[this.currentStep];
      if (!step) return;
      
      var self = this;
      
      // 如果有目标元素，飞过去
      if (step.target) {
        var targetEl = typeof step.target === 'string' 
          ? document.querySelector(step.target) 
          : step.target;
        
        if (targetEl) {
          this.flyTo(targetEl, function() {
            self.speak(step.speak || step.text || '看！那里有一个发光的圈圈，点一下试试！');
            self.showBalloon(step.text || '点一下试试！');
            self.highlightTarget(targetEl);
          });
        } else {
          // 找不到目标，直接显示提示
          this.speak(step.speak || step.text);
          this.showBalloon(step.text);
        }
      } else {
        // 没有目标，直接显示提示
        this.speak(step.speak || step.text);
        this.showBalloon(step.text);
      }
    },
    
    flyTo: function(targetEl, callback) {
      this.isFlying = true;
      
      var starRect = this.star.getBoundingClientRect();
      var targetRect = targetEl.getBoundingClientRect();
      
      var startX = starRect.left + starRect.width / 2;
      var startY = starRect.top + starRect.height / 2;
      var endX = targetRect.left + targetRect.width / 2;
      var endY = targetRect.top + targetRect.height / 2 - 40;
      
      // 创建飞行中的星星克隆体
      var flyingStar = document.createElement('div');
      flyingStar.className = 'star-guide-flying';
      flyingStar.textContent = '⭐';
      flyingStar.style.left = startX + 'px';
      flyingStar.style.top = startY + 'px';
      flyingStar.style.transform = 'translate(-50%, -50%)';
      document.body.appendChild(flyingStar);
      
      // 隐藏原星星
      this.container.classList.add('hidden');
      
      // 飞行动画
      var duration = 800;
      var startTime = null;
      
      function animate(now) {
        if (!startTime) startTime = now;
        var elapsed = now - startTime;
        var progress = Math.min(elapsed / duration, 1);
        
        // 缓动函数
        var ease = progress < 0.5 ? 2*progress*progress : -1+(4-2*progress)*progress;
        
        var curX = startX + (endX - startX) * ease;
        var curY = startY + (endY - startY) * ease;
        
        flyingStar.style.left = curX + 'px';
        flyingStar.style.top = curY + 'px';
        
        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          // 动画结束，移除飞行星星，显示原星星在目标位置
          document.body.removeChild(flyingStar);
          
          // 将原星星移到目标位置
          self.container.style.position = 'fixed';
          self.container.style.left = (endX - 30) + 'px';
          self.container.style.top = (endY - 30) + 'px';
          self.container.style.right = 'auto';
          self.container.style.bottom = 'auto';
          self.container.classList.remove('hidden');
          
          self.isFlying = false;
          if (callback) callback();
        }
      }
      
      requestAnimationFrame(animate);
    },
    
    returnToCorner: function() {
      if (this.isFlying) return;
      
      var self = this;
      
      // 创建飞行中的星星克隆体
      var starRect = this.star.getBoundingClientRect();
      var startX = starRect.left + starRect.width / 2;
      var startY = starRect.top + starRect.height / 2;
      
      var endX = window.innerWidth - 54;
      var endY = window.innerHeight - 54;
      
      var flyingStar = document.createElement('div');
      flyingStar.className = 'star-guide-flying';
      flyingStar.textContent = '⭐';
      flyingStar.style.left = startX + 'px';
      flyingStar.style.top = startY + 'px';
      flyingStar.style.transform = 'translate(-50%, -50%)';
      document.body.appendChild(flyingStar);
      
      this.container.classList.add('hidden');
      this.isFlying = true;
      
      var duration = 600;
      var startTime = null;
      
      function animate(now) {
        if (!startTime) startTime = now;
        var elapsed = now - startTime;
        var progress = Math.min(elapsed / duration, 1);
        
        var ease = progress < 0.5 ? 2*progress*progress : -1+(4-2*progress)*progress;
        
        var curX = startX + (endX - startX) * ease;
        var curY = startY + (endY - startY) * ease;
        
        flyingStar.style.left = curX + 'px';
        flyingStar.style.top = curY + 'px';
        
        if (progress < 1) {
          requestAnimationFrame(animate);
        } else {
          document.body.removeChild(flyingStar);
          
          self.container.style.position = 'fixed';
          self.container.style.right = '24px';
          self.container.style.bottom = '24px';
          self.container.style.left = 'auto';
          self.container.style.top = 'auto';
          self.container.classList.remove('hidden');
          
          self.isFlying = false;
        }
      }
      
      requestAnimationFrame(animate);
    },
    
    showBalloon: function(text) {
      if (!this.balloon) return;
      this.balloon.textContent = text;
      this.balloon.classList.add('show');
      
      // 3秒后自动隐藏
      setTimeout(function() {
        this.hideBalloon();
      }.bind(this), 3500);
    },
    
    hideBalloon: function() {
      if (!this.balloon) return;
      this.balloon.classList.remove('show');
    },
    
    highlightTarget: function(targetEl) {
      // 移除旧的光环
      if (this.targetGlow && this.targetGlow.parentNode) {
        this.targetGlow.parentNode.removeChild(this.targetGlow);
      }
      
      var rect = targetEl.getBoundingClientRect();
      this.targetGlow = document.createElement('div');
      this.targetGlow.className = 'star-guide-target-glow';
      this.targetGlow.style.left = (rect.left - 8) + 'px';
      this.targetGlow.style.top = (rect.top - 8) + 'px';
      this.targetGlow.style.width = (rect.width + 16) + 'px';
      this.targetGlow.style.height = (rect.height + 16) + 'px';
      
      document.body.appendChild(this.targetGlow);
      
      // 3秒后移除光环
      setTimeout(function() {
        if (this.targetGlow && this.targetGlow.parentNode) {
          this.targetGlow.parentNode.removeChild(this.targetGlow);
          this.targetGlow = null;
        }
      }.bind(this), 3500);
    },
    
    speak: function(text) {
      if (window.VoiceGuide && window.VoiceGuide.speak) {
        window.VoiceGuide.speak(text);
      }
    },
    
    nextStep: function() {
      // 清除目标光环
      if (this.targetGlow && this.targetGlow.parentNode) {
        this.targetGlow.parentNode.removeChild(this.targetGlow);
        this.targetGlow = null;
      }
      
      this.hideBalloon();
      this.currentStep++;
      
      // 返回角落
      setTimeout(function() {
        this.returnToCorner();
        
        // 重新启动空闲检测
        setTimeout(function() {
          this.startIdleTimer();
        }.bind(this), 1000);
      }.bind(this), 500);
    },
    
    reset: function() {
      this.currentStep = 0;
      this.returnToCorner();
      this.hideBalloon();
      if (this.targetGlow && this.targetGlow.parentNode) {
        this.targetGlow.parentNode.removeChild(this.targetGlow);
        this.targetGlow = null;
      }
      this.startIdleTimer();
    }
  };
  </script>


  <script>
  // STAR_GUIDE_STEPS_sloth - 小星星向导步骤配置
  (function() {
    function initStarGuide() {
      if (window.StarGuide) {
        window.StarGuide.init([
          
    { target: '#sloth-btn, .sloth-area', text: '按住树懒，喂它吃水果吧！', speak: '按住树懒，喂它吃水果吧！' }
    
        ]);
      } else {
        setTimeout(initStarGuide, 300);
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStarGuide);
    } else {
      initStarGuide();
    }
  })();
  </script>

</body>
</html>
